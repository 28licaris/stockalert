# StockAlert dev box — committed, NON-SECRET configuration.
# Spec: docs/operations/deployment_dev.md §3, §5, §7.
#
# bin/render_env.sh concatenates, in this order, into /opt/stockalert/.env:
#   1. this file              (committed; the environment's shape)
#   2. release.env            (APP_IMAGE — written by bin/release.sh)
#   3. SSM /stockalert/<env>/* (secrets; leaf name upper-cased, SSM wins)
#   4. derived values         (IDENTITY_DATABASE_URL, COGNITO_*_URI, BILLING_RETURN_URL, DEV_HOST fallback)
# Later lines win, so an SSM parameter can override anything here.
# Per-role flags (STREAM_PROVIDER, *_ENABLED) are set per container in
# docker-compose.yml and override this file — do not put them here.

# ── Environment ──────────────────────────────────────────────────────────────
STOCKALERT_ENV=dev
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE must stay UNSET: credentials come from the instance role
# (config.py _normalize_aws_env handles the blank case).
LOG_GROUP=/stockalert/dev

# DEV_HOST — the public hostname Caddy serves and Cognito/Stripe call back to.
# Empty = render_env.sh derives app.<eip-with-dashes>.sslip.io from the
# instance's public IP (§13: no domain yet). Set it here when a domain exists;
# the Cognito callback list and the Stripe webhook URL then need the new value.
DEV_HOST=

# ── Providers ────────────────────────────────────────────────────────────────
DATA_PROVIDER=schwab
HISTORY_PROVIDER=polygon
SCHWAB_BASE_URL=https://api.schwabapi.com
POLYGON_FLATFILES_ENABLED=false

# ── Lake (S3 + Glue) ─────────────────────────────────────────────────────────
STOCK_LAKE_BUCKET=stock-lake-562741918372-us-east-1-an
STOCK_LAKE_REGION=us-east-1
ICEBERG_CATALOG_NAME=stock_lake
ICEBERG_GLUE_DATABASE=stock_lake
ICEBERG_WAREHOUSE_PREFIX=iceberg
ICEBERG_EQUITIES_GLUE_DATABASE=equities
ICEBERG_FUTURES_GLUE_DATABASE=futures
ICEBERG_OPTIONS_GLUE_DATABASE=options
AWS_REQUEST_CHECKSUM_CALCULATION=when_required

# ── Nightly schedules (worker only; api sets every *_ENABLED=false) ──────────
POLYGON_NIGHTLY_RUN_HOUR_UTC=7
POLYGON_NIGHTLY_SYMBOLS=all
POLYGON_NIGHTLY_KIND=minute
SCHWAB_NIGHTLY_RUN_HOUR_UTC=22
SCHWAB_NIGHTLY_SYMBOLS=active
FUTURES_NIGHTLY_RUN_HOUR_UTC=22
FUTURES_NIGHTLY_SYMBOLS=active
FUTURES_POLYGON_NIGHTLY_RUN_HOUR_UTC=21
OPTIONS_SNAPSHOT_INTERVAL_SECONDS=300
OPTIONS_SNAPSHOT_SYMBOLS=active
OPTIONS_SNAPSHOT_STRIKE_COUNT=20
OPTIONS_SNAPSHOT_CONTRACT_TYPE=ALL
LAKE_WARMUP_ENABLED=false
SYMBOL_HOTLOAD_ENABLED=true
SYMBOL_HOTLOAD_DAYS=30
SYMBOL_GAPFILL_ENABLED=true

# ── ClickHouse (hot tier; password from SSM clickhouse_password) ─────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_DATABASE=stocks

# ── Identity / auth (secrets: SSM cognito_client_secret, postgres_password) ──
# IDENTITY_DATABASE_URL is derived by render_env.sh from POSTGRES_PASSWORD.
AUTH_ENABLED=true
ADMIN_EMAILS=shanelicari28@gmail.com
COGNITO_DOMAIN=https://stockalert-dev-562741918372.auth.us-east-1.amazoncognito.com
COGNITO_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_NxTarvrk4
COGNITO_CLIENT_ID=5tb9l4uv74jncbdm9vgd4lr76c
# COGNITO_REDIRECT_URI / COGNITO_LOGOUT_URI are derived from DEV_HOST.
AUTH_SESSION_HOURS=8
AUTH_LOGIN_TRANSACTION_MINUTES=10
AUTH_COOKIE_NAME=stockalert_session
AUTH_CSRF_COOKIE_NAME=stockalert_csrf
AUTH_COOKIE_SECURE=true
AUTH_PROVIDER_TOKEN_CIPHER=local

# ── Billing (Stripe TEST mode; secrets: SSM stripe_secret_key, stripe_webhook_secret)
# STRIPE_PRICE_* are test-mode price ids — not secret, but created per Stripe
# account, so they come from SSM too (stripe_price_monthly, stripe_price_annual).
BILLING_TRIAL_DAYS=0
# BILLING_RETURN_URL is derived from DEV_HOST.

# ── Misc ─────────────────────────────────────────────────────────────────────
MAX_BARS_PER_REQUEST=10000
USE_PARQUET_CACHE=false
