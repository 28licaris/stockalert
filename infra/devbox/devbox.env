# ── StockAlert devbox overrides ──────────────────────────────────────────────
# Appended to the devbox .env by `scripts/devbox/devbox.sh push-env`, which
# first copies the laptop .env MINUS every AWS_* credential line and minus any
# key set below. Spec: docs/operations/devbox.md.
#
# The devbox is NEVER an owner: the dev box (i-01baeadb537bf6b1d) alone streams
# Schwab and runs the nightlies. These flags keep a local uvicorn from trying;
# the read-only IAM role is the backstop (a lake write fails with AccessDenied).
#
# AWS creds: none here on purpose — boto3/PyIceberg use the instance role.

STREAM_PROVIDER=none
JOURNAL_ENABLED=false
LIVE_LAKE_WRITER_ENABLED=false
OPTIONS_SNAPSHOT_ENABLED=false
ELLIOTT_LIVE_SCANNER_ENABLED=false
ELLIOTT_RECOMPUTE_ENABLED=false
POLYGON_NIGHTLY_ENABLED=false
POLYGON_FLATFILES_ENABLED=false
SCHWAB_NIGHTLY_ENABLED=false
FUTURES_NIGHTLY_ENABLED=false
FUTURES_POLYGON_NIGHTLY_ENABLED=false
CH_RECONCILE_ENABLED=false
NEWS_INGEST_ENABLED=false
LAKE_GUARD_ENABLED=false
CH_STATE_SNAPSHOT_ENABLED=false
LAKE_WARMUP_ENABLED=false
SYMBOL_HOTLOAD_ENABLED=false
SYMBOL_GAPFILL_ENABLED=false
SILVER_DERIVED_ADD_MEMBERS_ENABLED=false
AWS_REGION=us-east-1
