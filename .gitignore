# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Local environment (never commit; copy .env.example to .env and fill in secrets)
.env
**/.env
**/.env.bak.*

# Local OAuth credentials and other developer secrets
/secrets/

# Schwab OAuth refresh token (written by scripts/schwab_get_refresh_token.py)
**/.schwab_refresh_token
**/data/.schwab_refresh_token

# macOS / editor noise
.DS_Store
**/.DS_Store
.cursor/
**/.cursor/

# Runtime app output
**/logs/
*.log

# Local clone of the massive (formerly Polygon) Python SDK, pulled via
# `pip install client-python/` as a path dep. Not vendored intentionally.
/client-python/

# Frontend cockpit (frontend/ has its own .gitignore for node_modules
# etc.) — the build artifact ships from CI, not from devs' machines.
/frontend/node_modules/
/app/static/dist/

# Claude Code session artifacts (worktrees are embedded git repos)
.claude/worktrees/
agent-skills/

# Runtime artifacts
.cache/
data_news.db
/data/

# ── Agent skills ──────────────────────────────────────────────────────
# CANONICAL LOCATION FOR OUR SKILLS: .claude/skills/<name>/SKILL.md
# That is what Claude Code reads, and it is where the repo's own skills
# (elliott-wave, preflight-change) have always lived. Add new ones there
# and commit them; nothing below should need touching.
#
# `.agents/skills/` is NOT ours — it is a third-party pack installed by
# its own `setup-matt-pocock-skills` script, which puts the real content
# in .agents/ and symlinks it into .claude/skills/ so Claude Code can see
# it. Both halves are ignored so the installer can manage them without
# polluting `git status`. A tracked copy of preflight-change was once
# swept into .agents/ by an unrelated commit (fef712a) and removed
# 2026-11-05 — do not recreate it.
/.agents/
/.claude/skills/ask-matt
/.claude/skills/codebase-design
/.claude/skills/diagnosing-bugs
/.claude/skills/domain-modeling
/.claude/skills/git-guardrails-claude-code
/.claude/skills/grill-me
/.claude/skills/grill-with-docs
/.claude/skills/grilling
/.claude/skills/handoff
/.claude/skills/improve-codebase-architecture
/.claude/skills/prototype
/.claude/skills/research
/.claude/skills/setup-matt-pocock-skills
/.claude/skills/tdd
/.claude/skills/teach
/.claude/skills/to-issues
/.claude/skills/to-prd
/.claude/skills/triage
/.claude/skills/writing-great-skills
